# --- GitHub ---
GH_TOKEN=ghp_...                          # repo scope on the target repo
TARGET_REPO=HirenRMistry/superset
DISPATCH_LABEL=devin-fix
GITHUB_WEBHOOK_SECRET=                    # optional; set if using real webhooks

# --- Devin API (https://docs.devin.ai/api-reference/overview) ---
DEVIN_API_KEY=cog_...                     # service-user key
DEVIN_ORG_ID=org-...
DEVIN_BASE_URL=https://api.devin.ai
# MAX_ACU_LIMIT=15                        # optional per-session spend cap

# --- Ops ---
POLL_INTERVAL_S=60
SIMULATE=false                            # true = no Devin calls, fake sessions (dry-run demo)
